<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <!-- The app given away (scripts/package.py): front and content inside the executable -->
  <ItemGroup Condition="'$(ContentBundle)' != ''">
    <EmbeddedResource Include="$(ContentBundle)" LogicalName="content.zip" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taleweaver.UnitTests" />
  </ItemGroup>

</Project>
