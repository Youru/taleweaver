{
  "name": "taleweaver-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "manual:shots": "playwright test -c playwright.manual.config.ts",
    "e2e": "playwright test",
    "pdf": "node scripts/print-pdf.mjs",
    "map-preview": "node scripts/map-preview.mjs",
    "diagram-check": "node scripts/diagram-check.mjs",
    "tile-palette": "node scripts/tile-palette.mjs",
    "tile-match": "node scripts/tile-match.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "8.0.7",
    "@primeuix/themes": "~2.0.3",
    "@tanstack/vue-query": "^5.107.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "~4.5.5",
    "qrcode": "1.5.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
